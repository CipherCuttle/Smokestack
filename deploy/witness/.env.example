# Bind the service to the deployment network explicitly.
WITNESS_HOST=0.0.0.0
WITNESS_PORT=8787

# This path is service-owned persistent storage. Do not use a qualification
# database or a client-owned path for a production deployment.
WITNESS_DATABASE_PATH=/var/lib/smokestack-witness/witness.sqlite

# Reference an externally provisioned Ed25519 PKCS#8 private key. This phase
# does not generate or provision the production key.
WITNESS_SIGNING_KEY_PATH=/run/secrets/witness-signing-key.pem

# Supply separately managed credentials at deployment time; never commit them.
WITNESS_RUNTIME_TOKEN=REPLACE_WITH_RUNTIME_CREDENTIAL
WITNESS_ADMIN_TOKEN=REPLACE_WITH_SEPARATE_ADMIN_CREDENTIAL
